# Required: JWT secret for token signing and encryption
# Generate: openssl rand -base64 32
JWT_SECRET=your-secure-random-secret-key-here

# Optional: JWT token expiration time (default: 1h)
# JWT_EXPIRES_IN=1h

# Optional: Separate encryption key (defaults to JWT_SECRET if not set)
# ENCRYPTION_KEY=your-encryption-key

# Optional: Encryption salt (default: observability-mcp-v1)
# ENCRYPTION_SALT=your-custom-salt

# Optional: Server port (default: 3000)
# PORT=3000
